{
  "manifest_version": 3,
  "name": "AI Token Optimizer",
  "version": "1.3.0",
  "description": "Shrinks AI chat uploads locally: docs to compact Markdown, large images downscaled. Fewer tokens, 100% private.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "image.png",
      "48": "image.png",
      "128": "image.png"
    }
  },
  "icons": {
    "16": "image.png",
    "48": "image.png",
    "128": "image.png"
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ai-token-optimizer@vinitgirdhar",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://*.perplexity.ai/*",
        "https://grok.com/*",
        "https://chat.deepseek.com/*",
        "https://chat.mistral.ai/*",
        "https://copilot.microsoft.com/*",
        "https://aistudio.google.com/*",
        "https://poe.com/*"
      ],
      "css": ["styles.css"],
      "js": [
        "lib/pdf.js",
        "lib/pdf.worker.js",
        "lib/mammoth.browser.min.js",
        "lib/xlsx.full.min.js",
        "lib/jszip.min.js",
        "converter.js",
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://*.perplexity.ai/*",
        "https://grok.com/*",
        "https://chat.deepseek.com/*",
        "https://chat.mistral.ai/*",
        "https://copilot.microsoft.com/*",
        "https://aistudio.google.com/*",
        "https://poe.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/pdf.worker.js",
        "lib/tesseract.min.js",
        "lib/tesseract-worker.min.js",
        "lib/tesseract-core.wasm.js",
        "lib/lang-data/*"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://*.perplexity.ai/*",
        "https://grok.com/*",
        "https://chat.deepseek.com/*",
        "https://chat.mistral.ai/*",
        "https://copilot.microsoft.com/*",
        "https://aistudio.google.com/*",
        "https://poe.com/*"
      ]
    }
  ]
}
